{
	"name": "wforacle",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"check:size": "tsx scripts/check-page-size.ts",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"data:build": "tsx scripts/build-data.ts",
		"lint": "oxlint",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions",
		"format": "oxfmt . && prettier --write -l \"**/*.svelte\"",
		"format:check": "oxfmt --check . && prettier --check \"**/*.svelte\""
	},
	"dependencies": {
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@wfcd/items": "^1.1275.27",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^29.1.1",
		"mdsvex": "^0.12.8",
		"msw": "^2.15.0",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"playwright": "^1.62.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"warframe-worldstate-data": "^3.16.3",
		"wrangler": "^4.114.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.11.0"
}
